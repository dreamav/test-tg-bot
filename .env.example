# Токен бота от @BotFather (обязательно)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Ваш Telegram ID (узнать можно у @userinfobot)
ADMIN_ID=123456789

# Канал для расписания (опционально, например -1001234567890)
SCHEDULE_CHANNEL_ID=

# Канал для обязательной подписки (если включено)
CHANNEL_ID=
CHANNEL_LINK=https://t.me/your_channel

# Включить проверку подписки на канал (True / False)
ENABLE_SUBSCRIPTION_CHECK=False

# Шаблон автонапоминания за 24 часа
REMINDER_TEXT_TEMPLATE="Напоминаем, что вы записаны на маникюр завтра в {time}.\nЖдём вас ❤️"

# Путь к файлу базы данных SQLite
DATABASE_PATH=database.db

# Часовой пояс
TIMEZONE=Europe/Moscow
